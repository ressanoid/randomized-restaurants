rules_version = '2';

// Firestore security rules for Random Restaurant.
// Anonymous Auth users are authenticated and carry a stable uid, so favorites
// are scoped per user. Nothing else is readable or writable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/favorites/{favoriteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == favoriteId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
